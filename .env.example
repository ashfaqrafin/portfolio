# Copy to .env.local for development. Every value is server-only: never prefix with NEXT_PUBLIC_.

# npx auth secret  (rotating it signs everyone out)
AUTH_SECRET=
# needed when self-hosting / `next start` behind your own proxy; Vercel detects the host itself
AUTH_TRUST_HOST=true

# GitHub OAuth app. Use separate apps for local dev and production.
# Callback URL: https://YOUR-DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The one account that may publish: the numeric `id` from
#   curl https://api.github.com/users/YOUR-USERNAME
# Missing or invalid means nobody can sign in (fails closed).
OWNER_GITHUB_ID=

# Postgres (Neon, Supabase, Vercel Postgres). Unset = Markdown files in content/articles,
# which only works locally: Vercel's disk is read-only, so production needs a database.
# Supabase: Project → Connect → "Transaction pooler" (port 6543) for the site,
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# and the "Session pooler" (port 5432) URL when running `npm run db:migrate` / `db:seed`.
DATABASE_URL=
# optional pool size per server instance
# DATABASE_POOL_MAX=5

# Contact form (optional): email the owner about each new message via Resend.
# Server-only. Leave empty to only keep messages in the studio inbox.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
# CONTACT_NOTIFY_FROM="Portfolio <hello@your-domain.com>"
