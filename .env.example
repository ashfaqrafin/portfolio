# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for this site. THIS FILE IS PUBLIC (it's in the repo):
# keep every value here empty. Real values go in two places only:
#
#   Local development:  .env.local  (copy this file to it; git never uploads it)
#   Production:         Vercel → Settings → Environment Variables (docs/deploy.md)
#
# Every value is a server-only secret: never prefix a name with NEXT_PUBLIC_
# (that would publish it to every visitor). Lines starting with # are notes.
# ─────────────────────────────────────────────────────────────────────────────


# ── Sign-in (GitHub) ─────────────────────────────────────────────────────────

# Encrypts the login cookie. Make one with:   openssl rand -base64 33
# Use a different one locally and in production. Changing it signs you out.
AUTH_SECRET=

# Local only: trust the localhost address. Don't set this on Vercel.
AUTH_TRUST_HOST=true

# From a GitHub OAuth app: GitHub → Settings → Developer settings → OAuth Apps.
# Make two apps, one for each place:
#   local:       Homepage http://localhost:3000
#                Redirect URI http://localhost:3000/api/auth/callback/github
#   production:  Homepage https://YOUR-SITE.vercel.app
#                Redirect URI https://YOUR-SITE.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The only GitHub account allowed to write: its numeric id, not the username.
# Find it with:   curl https://api.github.com/users/YOUR-USERNAME   ("id")
# Missing or wrong means nobody can sign in.
OWNER_GITHUB_ID=


# ── Database (Supabase) ──────────────────────────────────────────────────────

# Leave empty locally to read and write the Markdown files in content/articles.
# Production needs it (Vercel's disk is read-only).
#
# Supabase "Transaction pooler" address, port 6543, in this shape. Replace all
# three CAPITALISED parts, PROJECT-REF included:
#   PROJECT-REF: the id in your Supabase URL (https://PROJECT-REF.supabase.co)
#   PASSWORD:    the database password (letters and numbers only)
#   REGION:      Project Settings → General → Region, e.g. ap-southeast-1
#   postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# ("Tenant or user not found" means a part is wrong: check PROJECT-REF, then try aws-1-.)
DATABASE_URL=

# Setting the tables up uses the "Session pooler", the same address with port
# 5432, given only for the one command and not saved anywhere:
#   export DATABASE_URL='…:5432/postgres?sslmode=require'
#   npm run db:migrate && npm run db:seed && unset DATABASE_URL

# Optional: database connections per server instance (default 5).
# DATABASE_POOL_MAX=5


# ── Contact form emails (Resend, optional) ───────────────────────────────────

# Without these, contact messages are still saved: read them in Studio → Inbox.
# With them, you also get one email per message.
#   RESEND_API_KEY:     resend.com → API Keys → Create (Sending access), starts with re_
#   CONTACT_NOTIFY_TO:  where the email goes. On Resend's free plan without your
#                       own domain, it must be the address you signed up with.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=

# Optional: who the email comes from. Leave unset to use Resend's test sender;
# set it once you've verified your own domain in Resend.
# CONTACT_NOTIFY_FROM="Portfolio <hello@your-domain.com>"
